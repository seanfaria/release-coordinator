# -----------------------------------------------------------------------------
# Reverse proxy for the mock web service.
#
# This is a TEMPLATE. At container start, the official nginx image renders it to
# /etc/nginx/conf.d/default.conf and fills in ${NGINX_LOCAL_RESOLVERS} with the
# container's DNS server, taken from /etc/resolv.conf. That address differs by
# engine (Docker: 127.0.0.11, Podman: 10.89.0.1), so it is never hardcoded.
# Other nginx variables such as $host are left alone because they are not set
# in the environment.
#
# The live backend is defined in /etc/nginx/upstream/active.conf:
#   * Before any deploy: a placeholder that routes to the Compose "standalone"
#     container (rc-web-standalone), if you started it.
#   * After a deploy: written by deploy.py to point at the version it put live.
# To cut over, deploy.py rewrites that file and runs `nginx -s reload`. A reload
# is graceful: new workers take new requests, old workers finish in-flight ones,
# so no client connections are dropped.
# -----------------------------------------------------------------------------
resolver ${NGINX_LOCAL_RESOLVERS} valid=5s ipv6=off;
include /etc/nginx/upstream/active.conf;   # defines `upstream web_backend`

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass         http://web_backend;
        proxy_http_version 1.1;
        proxy_set_header   Connection        "";       # enables upstream keepalive
        proxy_set_header   Host              $http_host;        # keep the :port so app redirects stay correct
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    10s;
    }

    # nginx's own liveness, independent of any app version.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }
}
